# Copy to .env.local and fill in. .env.local is gitignored.

# Any Postgres you like (Homebrew, Docker, Postgres.app, a Neon branch...)
DATABASE_URL=postgres://localhost:5432/running_planner

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: plans each user can create (default 2)
# MAX_PLANS_PER_USER=2

# --- Deployed environments only (set in Vercel, not locally) ---
# Lets preview deploys sign in through production's Google callback. Same value in Production and Preview.
# OAUTH_PROXY_SECRET=
# Makes Vercel install the pnpm version pinned in package.json
# ENABLE_EXPERIMENTAL_COREPACK=1
